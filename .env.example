# Careers page (/careers). Copy the lines you need into .env.local or your host's
# environment settings. Never commit real values.

# MongoDB Atlas connection string (Atlas > Connect > Drivers). Applications are
# saved to the "job_applications" collection.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=gorevive
# Optional: max connections per server instance (default 10).
# MONGODB_MAX_POOL=10

# Resend (resend.com > API Keys). The sending domain must be verified in Resend.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Who the emails come from. Must be on the verified domain.
CAREERS_FROM=GoRevive Careers <careers@gorevive.in>
# Where new applications are sent. Comma-separate several addresses.
CAREERS_INBOX=hr@gorevive.in
# Silent copy (Bcc) of every new-application email. Comma-separate several addresses.
CAREERS_BCC=harsh.jha@gorevive.in
# Optional: reply-to on the candidate's confirmation (defaults to the first CAREERS_INBOX).
# CAREERS_REPLY_TO=hr@gorevive.in

# Cloudinary (console.cloudinary.com > Settings > API Keys). Resumes (PDF, max
# 5 MB) are uploaded by the browser straight to Cloudinary as private files.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: folder for resumes (default gorevive/resumes). Files go in <folder>/<role-slug>/.
# CLOUDINARY_RESUME_FOLDER=gorevive/resumes

# "Continue with Google" on the application form (optional; the button is hidden
# when unset). Google Cloud Console > APIs & Services > Credentials > OAuth client
# ID (Web application). Add your site and http://localhost:3000 under
# "Authorized JavaScript origins". No client secret is needed.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# HR page (/hr): who can sign in. Comma-separated; each gets a one-time email link.
CAREERS_ADMINS=harsh.jha@gorevive.in
# Sign-in links point here. Set to http://localhost:3000 in .env.local for local testing.
NEXT_PUBLIC_SITE_URL=https://www.gorevive.in
